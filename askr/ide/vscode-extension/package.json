{
  "name": "askr-status",
  "displayName": "Askr Status",
  "description": "Shows Claude Code session context usage and quota reset in the IDE status bar",
  "version": "1.0.0",
  "publisher": "askr",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "askr.openStatus",
        "title": "Askr: Show Session Status"
      },
      {
        "command": "askr.voiceMenu",
        "title": "Askr: Voice"
      },
      {
        "command": "askr.voicePushToTalk",
        "title": "Askr: Push to Talk"
      },
      {
        "command": "askr.toggleMic",
        "title": "Askr: Toggle Microphone"
      }
    ],
    "keybindings": [
      {
        "command": "askr.voicePushToTalk",
        "key": "ctrl+alt+space"
      },
      {
        "command": "askr.toggleMic",
        "key": "ctrl+alt+m",
        "mac": "cmd+m"
      }
    ]
  }
}
